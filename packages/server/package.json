{
  "name": "@srd5/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative WebSocket room server hosting @srd5/engine game sessions",
  "license": "CC-BY-4.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@srd5/data": "workspace:*",
    "@srd5/engine": "workspace:*",
    "@srd5/transport": "workspace:*",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
