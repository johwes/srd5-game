{
  "name": "srd5-game",
  "version": "0.1.0",
  "private": true,
  "description": "SRD 5.1 Tactical Turn-Based Dungeon Crawler",
  "license": "CC-BY-4.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"@srd5/*\" run build",
    "typecheck": "pnpm -r --filter \"@srd5/*\" run typecheck",
    "test": "pnpm -r --filter \"@srd5/*\" run test",
    "playtest": "tsx scripts/playtest.ts",
    "dev": "pnpm --filter @srd5/client run dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.65.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
